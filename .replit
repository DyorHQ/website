# DyorHQ landing — dependency-free static site.
# Press Run to preview; use Deploy → Static to publish.

run = "python3 -m http.server 5000 --bind 0.0.0.0 --directory public"
entrypoint = "public/index.html"

[[ports]]
localPort = 5000
externalPort = 80

# Static deployment: no build step. Only public/ is served, so README.md, REPLIT_BUILD_PROMPT.md and dotfiles
# at the repo root are never published.
[deployment]
deploymentTarget = "static"
publicDir = "public"
